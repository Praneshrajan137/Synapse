override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Mutation testing cache
.mutmut-cache/

# Sprint 5 test result artifacts
tests/load/results/
tests/api_fuzz/results/
tests/mutation/results/

# Feast registry (regenerated by feast apply)
data_fabric/feast/data/registry.db

# Neo4j data (volume-mounted)
# Redis dumps
dump.rdb

# Local scratch (plan extraction, ephemeral notes)
.tmp/

# Training artifacts (ADR-042): smoke/full-train write TrainResult JSON +
# checkpoints here. CI-produced and consumed by checkpoint/calibration truth
# gates; never committed (production checkpoints live in the MLflow registry).
artifacts/
# C60 uplift evidence (purpose-achievement-audit R2.8, AD-9/CF-4). Named
# explicitly, not just covered by `artifacts/`, because scripts/audit/uplift_truth.py
# reads this declaration: an in-repo artifact that no ignore rule covers is treated
# as read from version control and rejected. A committed measurement is not evidence
# of a run -- the artifact must be regenerated in the job that evaluates the gate.
artifacts/uplift/result.json
mlruns/
*.pt
*.ckpt
*.pth

# Generated Feast offline parquet (reproducible from data/<city>/demand_history.csv
# via scripts/build_feature_store.py; built in CI/operator before `feast materialize`).
data_fabric/feast/data/demand_signals.parquet
data_fabric/feast/*/data/demand_signals.parquet
data_fabric/feast/data/registry.db

# Claude Code local worktrees
.claude/

# Terraform local cache (the .tf source files ARE tracked; only the
# generated provider cache and lock-derived state are ignored).
infrastructure/gcp/terraform/.terraform/
infrastructure/oracle/terraform/.terraform/
**/.terraform/
*.tfstate
*.tfstate.backup
tfplan


