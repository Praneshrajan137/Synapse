{
  "name": "synapse-console",
  "private": true,
  "version": "1.0.0-p0",
  "description": "SYNAPSE Console — command center for an autonomous quick-commerce supply chain (Apache-2.0, $0 cost per I-1).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "tokens:build": "node ../design-system/color/build/build.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --max-diagnostics=200 ./src",
    "lint:fix": "biome check --write --max-diagnostics=200 ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:demo": "playwright test --grep @demo",
    "test:a11y": "playwright test --grep @a11y",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o .storybook-static",
    "storybook:test": "test-storybook",
    "domain:gen": "tsx scripts/gen-domain-zod.ts",
    "openapi:gen": "tsx scripts/gen-openapi.ts",
    "spec:check": "tsx scripts/check-fe-invariants.ts",
    "audit:licenses": "tsx scripts/audit-licenses.ts",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "mutation": "stryker run stryker.conf.json",
    "sbom": "pnpm dlx @cyclonedx/cdxgen@^10 -o sbom.cdx.json -t javascript .",
    "audit:supply": "pnpm audit --audit-level=high && node scripts/check-supply-chain.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.34",
    "@deck.gl/core": "^9.0.34",
    "@deck.gl/geo-layers": "^9.0.34",
    "@deck.gl/layers": "^9.0.34",
    "@deck.gl/react": "^9.0.34",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@visx/axis": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^4.7.1",
    "openapi-fetch": "^0.13.0",
    "pmtiles": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "sigma": "^3.0.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "web-vitals": "^4.2.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-app": "^11.1.6",
    "@storybook/addon-a11y": "^8.3.5",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.3.5",
    "@storybook/blocks": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@storybook/test": "^8.3.5",
    "@storybook/test-runner": "^0.19.1",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "@vitest/ui": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "json-schema-to-zod": "^2.4.1",
    "msw": "^2.4.9",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "size-limit": "^11.1.6",
    "storybook": "^8.3.5",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vitest-axe": "^0.1.0"
  },
  "size-limit": [
    {
      "name": "entry bundle (gzip)",
      "path": "dist/assets/index-*.js",
      "limit": "180 KB"
    },
    {
      "name": "react-vendor (gzip)",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "70 KB"
    }
  ],
  "pnpm": {
    "overrides": {
      "tmp": ">=0.2.6"
    },
    "overridesRationale": {
      "tmp": "GHSA-ph9p-34f9-6g65 (arbitrary tmpdir write in tmp<0.2.4). Transitive via Stryker -> @inquirer/prompts -> external-editor. Patched range: >=0.2.6. See SECURITY.md."
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5xrq-8626-4rwp"
      ]
    },
    "auditConfigRationale": {
      "GHSA-5xrq-8626-4rwp": "vitest <4.1.0 — the Vitest UI dev server can serve arbitrary files when listening. Dev-only (devDependency @vitest/ui), reachable ONLY via the local `test:ui` script; never run in CI or production (CI runs `vitest run` headless). The patched range is vitest>=4.1.0, a major upgrade from our 2.x line that would break the current runner/config; tracked for a deliberate vitest 4 migration. Ignored at audit per the same dev-only-advisory policy as the `tmp` override above."
    }
  }
}
