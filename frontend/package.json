{
  "name": "synapse-atlas-console",
  "private": true,
  "version": "1.0.0-alpha.1",
  "description": "SYNAPSE Atlas Console — regulator-grade ops control surface for the 8-agent quick-commerce supply chain. Six DDD-bounded surfaces (Living City, Mission Control, Decision Trace, Twin Studio, Agent Floor, Audit Vault).",
  "type": "module",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --dir src --testNamePattern \"prop:\"",
    "test:contract": "vitest run --dir src --testNamePattern \"contract:\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:bdd": "cucumber-js",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "test-storybook --url http://localhost:6006",
    "orval": "orval --config orval.config.ts",
    "schemas:zod": "node scripts/json-schema-to-zod.mjs",
    "lhci": "lhci autorun",
    "bundle:check": "vite-bundle-visualizer -o stats.html && node scripts/bundle-budget.mjs",
    "sbom": "cdxgen -o sbom.cdx.json -t javascript .",
    "audit:supply": "pnpm audit --audit-level=high && lockfile-lint -p pnpm-lock.yaml --type pnpm --validate-https --allowed-hosts npm",
    "mutation": "stryker run --config-file stryker.conf.json",
    "i18n:check": "i18next-parser --config i18next-parser.config.cjs --fail-on-warnings --fail-on-update",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.79.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@deck.gl/core": "^9.0.30",
    "@deck.gl/layers": "^9.0.30",
    "@deck.gl/react": "^9.0.30",
    "maplibre-gl": "^4.7.1",
    "recharts": "^2.13.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/axis": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/brush": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/event": "^3.12.0",
    "@visx/text": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/network": "^3.12.0",
    "react-force-graph-3d": "^1.25.4",
    "three": "^0.169.0",
    "d3-force-3d": "^3.0.5",
    "zustand": "^5.0.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.0",
    "react-i18next": "^15.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.452.0",
    "dompurify": "^3.1.7",
    "web-vitals": "^4.2.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-web": "^1.27.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/instrumentation-fetch": "^0.54.0",
    "@opentelemetry/context-zone": "^1.27.0",
    "@unleash/proxy-client-react": "^4.4.1",
    "unleash-proxy-client": "^3.7.1",
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.9",
    "vite-plugin-checker": "^0.8.0",
    "@tanstack/router-vite-plugin": "^1.79.0",
    "@tanstack/router-devtools": "^1.79.0",
    "vite-bundle-visualizer": "^1.2.1",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2",
    "@vitest/ui": "^2.1.2",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/jest-dom": "^6.5.0",
    "fast-check": "^3.22.0",
    "@playwright/test": "^1.48.0",
    "@axe-core/playwright": "^4.10.0",
    "@cucumber/cucumber": "^11.0.1",
    "playwright-cucumber-adapter": "^0.1.0",
    "msw": "^2.4.9",
    "msw-storybook-addon": "^2.0.3",
    "storybook": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-interactions": "^8.3.5",
    "@storybook/addon-themes": "^8.3.5",
    "@storybook/addon-a11y": "^8.3.5",
    "@storybook/test": "^8.3.5",
    "@storybook/test-runner": "^0.19.1",
    "@storybook/blocks": "^8.3.5",
    "chromatic": "^11.12.5",
    "orval": "^7.2.0",
    "json-schema-to-zod": "^2.4.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-storybook": "^0.9.0",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "lockfile-lint": "^4.14.0",
    "@cyclonedx/cdxgen": "^10.10.7",
    "@lhci/cli": "^0.14.0",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/vitest-runner": "^8.6.0",
    "@stryker-mutator/typescript-checker": "^8.6.0",
    "tsx": "^4.19.1",
    "yaml": "^2.6.0",
    "ajv": "^8.17.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "_synapseLicenseAllowList": [
    "MIT",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "PSF",
    "ISC",
    "MPL-2.0"
  ]
}
