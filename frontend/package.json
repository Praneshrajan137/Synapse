{
  "name": "synapse-synaptic-calm",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "SYNAPSE — The Synaptic Calm Interface. An operating theater for autonomous decisions.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:imports": "tsx scripts/forbidden-imports.ts",
    "audit:licenses": "tsx scripts/license-audit.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit:imports"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-virtual": "^3.11.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "motion": "^11.15.0",
    "zustand": "^5.0.2",
    "cmdk": "^1.0.4",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/context-zone": "^1.30.0",
    "@opentelemetry/instrumentation": "^0.57.0",
    "@opentelemetry/instrumentation-fetch": "^0.57.0",
    "@opentelemetry/instrumentation-document-load": "^0.45.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@biomejs/biome": "^1.9.4",
    "vitest": "^3.0.5",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^25.0.1",
    "jest-axe": "^9.0.0",
    "@playwright/test": "^1.49.1",
    "@axe-core/playwright": "^4.10.1",
    "storybook": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "msw": "^2.7.0",
    "tsx": "^4.19.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
