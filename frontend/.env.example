# SYNAPSE Frontend — environment variables (Vite uses VITE_ prefix)
# Dev defaults assume the local docker-compose stack.
#
# Every VITE_ value is compiled into the PUBLIC bundle (ADR-057, finding 89):
# never put a credential, token or password here. The console learns how to
# enter from GET /api/v1/auth/mode at boot; it carries no sign-in of its own.

VITE_ORCHESTRATOR_URL=http://localhost:8085
VITE_GATEWAY_URL=http://localhost:8080
VITE_TWIN_URL=http://localhost:8009
VITE_DEFAULT_CITY=bengaluru
VITE_TILES_URL=/tiles/india.pmtiles
VITE_TELEMETRY_ENDPOINT=/api/v1/telemetry
