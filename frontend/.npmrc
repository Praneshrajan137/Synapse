; SYNAPSE Atlas Console — pnpm config.
; Stricter peer-dep enforcement than pnpm's default; prevents the "phantom
; dependency" class of bugs (a package importing something it didn't declare).
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-frozen-lockfile=true
package-lock=false
engine-strict=true
node-linker=isolated
