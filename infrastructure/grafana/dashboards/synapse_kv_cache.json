{
  "dashboard": {
    "id": null,
    "uid": "synapse-kvcache",
    "title": "SYNAPSE KV-Cache (I-13)",
    "tags": ["synapse", "ollama", "kv-cache"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Ollama Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "synapse_ollama_cache_hit_rate",
            "legendFormat": "{{ model }} / {{ tier }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.60},
                {"color": "green", "value": 0.70}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Prefill Tokens Histogram",
        "type": "histogram",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "expr": "rate(synapse_ollama_prefill_tokens_bucket[5m])",
            "legendFormat": "{{ le }}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Tier Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "expr": "sum(synapse_decisions_total) by (tier)",
            "legendFormat": "{{ tier }}"
          }
        ]
      },
      {
        "id": 4,
        "title": "Cache Invalidation Events",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "rate(synapse_decisions_total{outcome=\"cache_invalidated\"}[5m])",
            "legendFormat": "{{ agent_name }}"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "ops"}
        }
      }
    ]
  }
}
