# ============================================================================
# SYNAPSE GCP deployment — copy to terraform.tfvars and edit
# ============================================================================
# `terraform.tfvars` is .gitignored — never commit it.
# ============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your GCP project ID (NOT the display name).
# Find at https://console.cloud.google.com/ → top bar → project info → ID.
# Looks like "synapse-demo-471203".
project_id = "REPLACE_ME"

# ── Highly recommended to set ────────────────────────────────────────────────

# Where to deploy. asia-south1 (Mumbai) is closest to India.
# Other reasonable picks: us-central1, europe-west1, asia-southeast1 (Singapore).
region = "asia-south1"
zone   = "asia-south1-a"

# Path to the public half of your SSH key.
# Generate with: ssh-keygen -t ed25519 -f $HOME/.ssh/gcp_synapse -N ""
ssh_public_key_path = "~/.ssh/gcp_synapse.pub"

# Lock SSH + management ports to your home IP.
# Find yours at https://whatismyipaddress.com, then add "/32".
# Leave as 0.0.0.0/0 only for the first 10 minutes if you're behind a changing IP.
admin_ip_cidr = "0.0.0.0/0"

# ── Optional overrides ───────────────────────────────────────────────────────

# vm_name      = "synapse-demo"
# machine_type = "e2-standard-8"   # 8 vCPU / 32 GB RAM
# use_spot_vm  = false             # true = ~70% cheaper but preemptible
# boot_disk_gb = 30
# data_disk_gb = 100

# backup_bucket_location = "asia-south1"     # regional. For dual-region use "asia1"/"nam4"/"eur4".
# backup_retention_days  = 7

# ── Tier-A hardening (ADR-037) ──────────────────────────────────────────────

# REQUIRED to enable budget alerts. Find at:
#   gcloud billing accounts list
# billing_account_id  = "XXXXXX-XXXXXX-XXXXXX"
# budget_amount_usd   = 300        # full free trial credit
# budget_alert_email  = "you@example.com"

# Workload Identity Federation pool gates GitHub Actions OIDC tokens.
# github_repo = "Praneshrajan137/synapse"

# Artifact Registry Docker repo (lowercase, hyphens only).
# artifact_registry_repo = "synapse"

# Auto-stop schedule (defaults = 09:00-23:00 IST).
# enable_auto_stop     = true
# auto_stop_start_cron = "30 3 * * *"
# auto_stop_stop_cron  = "30 17 * * *"

# ── Tier-B hardening (ADR-037) ──────────────────────────────────────────────

# IAP-only access. When true, admin ports (Grafana/Prometheus/...) and SSH
# are reachable only via `gcloud compute start-iap-tunnel`.
# use_iap_only = true
# iap_users = ["user:you@example.com", "group:team@example.com"]

# Cloud DNS managed zone — empty disables.
# deploy_domain         = "synapse.example.com"
# managed_zone_dns_name = "example.com."   # trailing dot is required

# GCS backup bucket versioning (recommended ON).
# enable_bucket_versioning = true

# Cloud Armor WAF + global HTTPS LB (adds ~$18/mo for the LB).
# enable_cloud_armor = false
