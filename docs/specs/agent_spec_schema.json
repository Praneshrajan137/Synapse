{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synapse.sdd.agent_spec",
  "title": "SYNAPSE Agent Behavioral Specification",
  "description": "Single source of truth for Spec-Driven Development (SDD)",
  "type": "object",
  "required": ["agent_name", "version", "invariants", "preconditions", "postconditions", "state_machine"],
  "properties": {
    "agent_name": {"type": "string"},
    "version": {"type": "string"},
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "assertion"],
        "properties": {
          "id": {"type": "string", "pattern": "^INV-[A-Z]+-\\d{3}$"},
          "description": {"type": "string"},
          "assertion": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium"]}
        }
      },
      "minItems": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^PRE-[A-Z]+-\\d{3}$"},
          "description": {"type": "string"},
          "check": {"type": "string"}
        }
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "properties": {
          "id": {"type": "string", "pattern": "^POST-[A-Z]+-\\d{3}$"},
          "description": {"type": "string"},
          "check": {"type": "string"}
        }
      }
    },
    "state_machine": {
      "type": "object",
      "required": ["states", "transitions", "initial_state"],
      "properties": {
        "initial_state": {"type": "string"},
        "states": {"type": "array", "items": {"type": "string"}},
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "trigger"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "trigger": {"type": "string"},
              "guard": {"type": "string"},
              "timeout_seconds": {"type": "number"}
            }
          }
        }
      }
    },
    "metamorphic_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "transform", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^MR-[A-Z]+-\\d{3}$"},
          "description": {"type": "string"},
          "transform": {"type": "string"},
          "expected": {"type": "string"}
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["producer", "expectations"],
        "properties": {
          "producer": {"type": "string"},
          "expectations": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
