{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synapse.local/schema/color-spec.schema.json",
  "title": "SYNAPSE Chromatic System Specification",
  "description": "Schema for color-system.spec.yml (SDD layer). Distinct from the agent spec.yaml schema by design — see ADR-025.",
  "type": "object",
  "required": ["system_name", "version", "description", "invariants"],
  "additionalProperties": false,
  "properties": {
    "system_name": { "const": "synapse-color" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "assertion", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^INV-CLR-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 1 },
          "assertion": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^PRE-CLR-[0-9]{3}$" },
          "description": { "type": "string" },
          "check": { "type": "string" }
        }
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "check"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^POST-CLR-[0-9]{3}$" },
          "description": { "type": "string" },
          "check": { "type": "string" }
        }
      }
    },
    "metamorphic_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "transform", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^MR-CLR-[0-9]{3}$" },
          "description": { "type": "string" },
          "transform": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "palettes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "encoding"],
        "properties": {
          "description": { "type": "string" },
          "encoding": { "enum": ["hue", "lightness", "diverging", "categorical", "neutral", "chroma-factor"] },
          "members": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "testing_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "applies"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string" },
          "applies": { "type": "string" }
        }
      }
    }
  }
}
