# ============================================================================
# SYNAPSE — Oracle Always-Free Deployment Environment (Sprint 6)
# Copy to .env on the Oracle Cloud VM. NEVER commit a filled-in copy.
# `.env.cloud*` is gitignored.
#
# Oracle is the secondary / cost-anchor deployment target (ADR-037).
# Primary is GCP — see `.env.cloud.gcp.example`.
# ============================================================================

SYNAPSE_DEPLOY_TARGET=oracle
SYNAPSE_ENV=production

# ---------------------------------------------------------------------------
# Neo4j Aura Free (https://console.neo4j.io)
# Limits: 1 db, 50k nodes, 175k relationships
# ---------------------------------------------------------------------------
NEO4J_AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=<your-aura-generated-password>

# ---------------------------------------------------------------------------
# Pinecone Starter (https://app.pinecone.io) — 2GB / 5 indexes
# ---------------------------------------------------------------------------
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=synapse-playbooks
PINECONE_ENVIRONMENT=us-east-1

# ---------------------------------------------------------------------------
# LangSmith Developer (5,000 traces/month)
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=synapse-production
LANGSMITH_TRACING_V2=true

# ---------------------------------------------------------------------------
# Local containers
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
POSTGRES_AUDIT_URI=postgresql://synapse:synapse_audit_2026@postgres:5432/synapse_audit
MLFLOW_TRACKING_URI=http://mlflow:5000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
