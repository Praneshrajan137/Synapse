{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synapse.domain.route_plan",
  "title": "Routing Navigator Plan Output",
  "type": "object",
  "required": ["route_id", "rider_id", "store_id", "stops", "total_distance_km", "total_time_min"],
  "properties": {
    "route_id": {"type": "string", "format": "uuid"},
    "rider_id": {"type": "string"},
    "store_id": {"type": "string"},
    "stops": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "total_distance_km": {"type": "number", "minimum": 0},
    "total_time_min": {"type": "number", "minimum": 0},
    "fuel_estimate_liters": {"type": "number", "minimum": 0},
    "freshness_violations": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
