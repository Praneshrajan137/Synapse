{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synapse.domain.inventory_action",
  "title": "Inventory Sentinel Action Output",
  "type": "object",
  "required": ["store_id", "sku_id", "action_type", "quantity", "safety_stock_multiplier", "reorder_point", "confidence"],
  "properties": {
    "store_id": {"type": "string"},
    "sku_id": {"type": "string"},
    "action_type": {"type": "string", "enum": ["reorder", "transfer", "markdown"]},
    "quantity": {"type": "number", "minimum": 0},
    "safety_stock_multiplier": {"type": "number", "minimum": 1.0, "maximum": 3.0},
    "reorder_point": {"type": "number", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  },
  "additionalProperties": false
}
