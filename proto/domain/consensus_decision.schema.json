{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synapse.domain.consensus_decision",
  "title": "Orchestrator Consensus Decision",
  "type": "object",
  "required": [
    "decision_id",
    "timestamp",
    "tier",
    "proposals",
    "selected_action",
    "pareto_weights",
    "confidence",
    "audit_trace"
  ],
  "properties": {
    "decision_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tier": { "type": "string", "enum": ["tier_1", "tier_2", "tier_3", "tier_4"] },
    "proposals": { "type": "array", "items": { "type": "object" } },
    "selected_action": { "type": "object" },
    "pareto_weights": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "escalated_to_human": { "type": "boolean" },
    "human_override": { "type": ["object", "null"] },
    "audit_trace": { "type": "array", "items": { "type": "string" } },
    "phase_reached": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
    "debate_rounds": { "type": "integer", "minimum": 0, "default": 0 },
    "pareto_front": {
      "type": ["array", "null"],
      "items": { "type": "object" }
    },
    "context_messages": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "execution_confirmations": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "audit_id": { "type": ["string", "null"], "format": "uuid" },
    "rationale": {
      "type": ["object", "null"],
      "description": "ConsensusRationale recorded at the Pareto knee. ADR-028.",
      "properties": {
        "selected_scores": { "type": "object" },
        "runner_up_scores": { "type": "object" },
        "tradeoff_vector": { "type": "object" },
        "sensitivity": { "type": "object" },
        "dominated_alternatives": { "type": "integer", "minimum": 0 },
        "knee_distance": { "type": "number", "minimum": 0.0 },
        "weights_used": { "type": "object" }
      }
    },
    "counterfactuals": {
      "type": ["array", "null"],
      "description": "Per-objective counterfactual sweep at decision time. ADR-028.",
      "items": {
        "type": "object",
        "properties": {
          "objective": { "type": "string" },
          "delta": { "type": "number" },
          "original_knee_index": { "type": "integer", "minimum": 0 },
          "new_knee_index": { "type": "integer", "minimum": 0 },
          "flipped": { "type": "boolean" },
          "biggest_shift": { "type": "object" }
        }
      }
    },
    "correlation_id": {
      "type": ["string", "null"],
      "description": "Stable id for the originating user/decision flow. ADR-027."
    },
    "causation_chain": {
      "type": ["array", "null"],
      "description": "Ordered list of upstream a2a request ids that caused this decision. ADR-027.",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
