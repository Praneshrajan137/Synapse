{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synapse.domain.pricing_decision",
  "title": "Pricing Oracle Decision Output",
  "type": "object",
  "required": ["sku_id", "store_id", "category_id", "is_essential", "base_price", "multiplier", "final_price"],
  "properties": {
    "sku_id": {"type": "string"},
    "store_id": {"type": "string"},
    "category_id": {"type": "string"},
    "is_essential": {"type": "boolean"},
    "base_price": {"type": "number", "exclusiveMinimum": 0},
    "multiplier": {"type": "number", "exclusiveMinimum": 0},
    "final_price": {"type": "number", "exclusiveMinimum": 0}
  },
  "if": {"properties": {"is_essential": {"const": true}}},
  "then": {"properties": {"multiplier": {"maximum": 1.3}}},
  "additionalProperties": false
}
