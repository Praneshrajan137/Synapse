{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PricingUpdate",
  "type": "object",
  "required": ["pricing_id", "sku_id", "category", "base_price", "multiplier",
                "final_price", "is_essential", "elasticity_source", "timestamp", "confidence"],
  "properties": {
    "pricing_id": {"type": "string", "format": "uuid"},
    "sku_id": {"type": "string"},
    "store_id": {"type": "string"},
    "category": {"type": "string"},
    "base_price": {"type": "number", "minimum": 0},
    "multiplier": {"type": "number", "minimum": 0.5, "maximum": 2.0},
    "final_price": {"type": "number", "minimum": 0},
    "is_essential": {"type": "boolean"},
    "elasticity_source": {"type": "string", "enum": ["causal_doubleml", "correlation_fallback", "manual"]},
    "causal_elasticity": {"type": ["number", "null"]},
    "competitor_delta_pct": {"type": ["number", "null"]},
    "demand_forecast_impact": {"type": ["number", "null"]},
    "essential_cap_enforced": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "audit_id": {"type": "string", "format": "uuid"}
  },
  "additionalProperties": false
}
