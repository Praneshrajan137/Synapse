# ============================================================================
# SYNAPSE Docker Environment — Copy to .env and customize
# ============================================================================

# ── Kafka ──
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=8
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_LOG_RETENTION_HOURS=72

# ── Redis ──
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ── Neo4j ──
NEO4J_AUTH=neo4j/synapse_graph_2026
NEO4J_PLUGINS=["apoc"]
NEO4J_dbms_memory_heap_max__size=1G
NEO4J_dbms_memory_pagecache_size=512M

# ── PostgreSQL (Audit Trail — I-4) ──
POSTGRES_DB=synapse_audit
POSTGRES_USER=synapse
POSTGRES_PASSWORD=synapse_audit_2026

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=synapse_grafana_2026
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/synapse_infrastructure.json

# ── MLflow ──
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# ── Feast ──
FEAST_REDIS_HOST=redis
FEAST_REDIS_PORT=6379

# ── Ollama ──
OLLAMA_HOST=http://host.docker.internal:11434

# ── Application ──
SYNAPSE_ENV=development
SYNAPSE_LOG_LEVEL=INFO
SYNAPSE_CONFIDENCE_THRESHOLD=0.7
SYNAPSE_ESSENTIAL_PRICE_CAP=1.3
