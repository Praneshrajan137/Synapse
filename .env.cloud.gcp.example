# ============================================================================
# SYNAPSE — GCP Deployment Environment (Sprint 10 / ADR-036)
# Copy to .env on the target GCP VM. NEVER commit a filled-in copy.
# `.env.cloud*` is gitignored.
#
# This file is the GCP twin of `.env.cloud.oracle.example`. Per ADR-037, both
# deployment targets are first-class — choose by setting SYNAPSE_DEPLOY_TARGET.
# ============================================================================

SYNAPSE_DEPLOY_TARGET=gcp
SYNAPSE_ENV=production

# ---------------------------------------------------------------------------
# Identity & secret storage (Workload Identity Federation: no JSON keys ever)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=synapse-prod          # replace with your project id
GCP_REGION=asia-south1               # Mumbai region — closest to Bengaluru ops
GCP_ZONE=asia-south1-a

# All secrets resolve at boot via gcloud secrets versions access ...
# Each entry is the Secret Manager resource path, not the secret itself.
NEO4J_AURA_URI_SECRET=projects/synapse-prod/secrets/neo4j-aura-uri/versions/latest
NEO4J_AURA_USER_SECRET=projects/synapse-prod/secrets/neo4j-aura-user/versions/latest
NEO4J_AURA_PASSWORD_SECRET=projects/synapse-prod/secrets/neo4j-aura-password/versions/latest

PINECONE_API_KEY_SECRET=projects/synapse-prod/secrets/pinecone-api-key/versions/latest
PINECONE_INDEX_NAME=synapse-playbooks
PINECONE_ENVIRONMENT=us-east-1

LANGSMITH_API_KEY_SECRET=projects/synapse-prod/secrets/langsmith-api-key/versions/latest
LANGSMITH_PROJECT=synapse-production
LANGSMITH_TRACING_V2=true

POSTGRES_AUDIT_URI_SECRET=projects/synapse-prod/secrets/postgres-audit-uri/versions/latest

# ---------------------------------------------------------------------------
# Local containers (run on the GCP VM)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
MLFLOW_TRACKING_URI=http://mlflow:5000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------------------------------------------------------------------------
# Observability — exported to GCP Cloud Operations via OTel collector
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_RESOURCE_ATTRIBUTES=service.namespace=synapse,deployment.environment=production

# ---------------------------------------------------------------------------
# Cost guardrails (mirrored by infrastructure/gcp/terraform/budget.tf)
# ---------------------------------------------------------------------------
GCP_BUDGET_USD=50                    # alert at 50% / 80% / 100% of this
GCP_BUDGET_ALERT_EMAIL=ops@synapse.example
