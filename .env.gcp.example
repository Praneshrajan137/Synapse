# ============================================================================
# SYNAPSE — Google Cloud environment overrides
# Copy to `.env.gcp` (which is .gitignored) and edit.
# ============================================================================

# ── Domain + TLS (set both to enable HTTPS via Let's Encrypt) ───────────────
# Free option: register a subdomain at https://www.duckdns.org and point it
# at $GCP_IP, e.g. DOMAIN_NAME=synapse-demo.duckdns.org
DOMAIN_NAME=
LETSENCRYPT_EMAIL=

# ── Secrets — change these from defaults before deploying anywhere real ────
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please-2026
NEO4J_URI=bolt://neo4j:7687

POSTGRES_DB=synapse_audit
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-too-2026

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-as-well-2026
GRAFANA_ROOT_URL=https://${DOMAIN_NAME}/grafana/

# ── LLM ────────────────────────────────────────────────────────────────────
# 7b fits in 5 GB; 14b needs ~10 GB and slows the 8 vCPU VM noticeably.
# Switching models requires re-running `ollama pull` on the VM.
OLLAMA_MODEL=deepseek-r1:7b

# ── Optional external services (leave blank to no-op those features) ───────
# Pinecone Free Starter: https://app.pinecone.io
PINECONE_API_KEY=

# LangSmith free tier: https://smith.langchain.com
LANGSMITH_API_KEY=

# ── Build metadata (surfaced in the frontend footer) ───────────────────────
BUILD_SHA=gcp-$(date +%Y%m%d)

# ── Access posture (ADR-057) — deliberately NOT configured here ────────────
# SYNAPSE_ACCESS_MODE / SYNAPSE_OPEN_AUTHORITY are literal values in
# docker/docker-compose.gcp.yml (open + view), so changing the posture is a
# reviewed commit, not an edit to this file on the VM. SYNAPSE_OPERATORS_JSON
# (the scrypt operator store) is provisioned from Secret Manager at activation
# and never written to this file: an EMPTY value is malformed and refuses
# startup. The insecure development operator table must never be enabled here.
